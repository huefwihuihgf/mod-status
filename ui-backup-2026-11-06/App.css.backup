@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #30291f;
  background: #faf9f7;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.dashboard {
  min-height: 100vh;
  padding-bottom: 100px;
}

.topbar {
  height: 76px;
  padding: 0 6%;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1px solid #eee9e2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(15px);
}

.brand-button {
  display: flex;
  align-items: center;
  gap: 10px;
  border: none;
  background: none;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: 1px;
  color: #30291f;
}

.brand-button > span:last-child span {
  color: #e98b3c;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: #fff0e3;
  display: grid;
  place-items: center;
  font-size: 23px;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 13px;
}

.topbar-greeting {
  color: #81796f;
  font-size: 13px;
  font-weight: 600;
}

.small-avatar,
.profile-avatar {
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #ffe8d4;
  color: #d8792d;
  font-weight: 800;
}

.small-avatar {
  width: 39px;
  height: 39px;
}

.main-content {
  width: min(1120px, 90%);
  margin: 0 auto;
  padding: 48px 0 55px;
}

.welcome-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
}

.small-eyebrow,
.hero-label {
  color: #e98b3c;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.welcome-section h1,
.page-content h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(30px, 4vw, 43px);
  margin: 10px 0 7px;
  line-height: 1.2;
}

.welcome-section h1 span {
  font-family: 'DM Sans', sans-serif;
  font-size: 25px;
}

.welcome-section p,
.page-description {
  margin: 0;
  color: #898076;
  font-size: 14px;
  line-height: 1.7;
}

.profile-avatar {
  width: 58px;
  height: 58px;
  font-size: 23px;
}

.hero-card {
  min-height: 300px;
  display: grid;
  grid-template-columns: 1fr 0.9fr;
  overflow: hidden;
  border-radius: 23px;
  background: #fff0e3;
  margin-bottom: 42px;
}

.hero-copy {
  padding: 39px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.hero-copy h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(27px, 3vw, 36px);
  line-height: 1.2;
  max-width: 390px;
  margin: 14px 0 12px;
}

.hero-copy p {
  color: #83766a;
  font-size: 13px;
  line-height: 1.7;
  max-width: 370px;
  margin: 0 0 22px;
}

.hero-button,
.primary-button {
  border: none;
  background: #e98b3c;
  color: white;
  border-radius: 11px;
  padding: 14px 19px;
  font-size: 13px;
  font-weight: 700;
  transition: 0.2s;
}

.hero-button:hover,
.primary-button:hover {
  background: #d8792d;
  transform: translateY(-2px);
}

.hero-button span {
  margin-left: 13px;
  font-size: 18px;
}

.hero-image {
  min-height: 300px;
}

.hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 19px;
}

.section-heading h2 {
  font-family: 'Playfair Display', serif;
  font-size: 23px;
  margin: 0 0 6px;
}

.section-heading p {
  margin: 0;
  font-size: 12px;
  color: #92887e;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 43px;
}

.quick-card {
  position: relative;
  min-height: 145px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  gap: 8px;
  background: white;
  border: 1px solid #eee9e2;
  border-radius: 17px;
  transition: 0.2s;
}

.quick-card:hover {
  border-color: #f0bd91;
  transform: translateY(-3px);
  box-shadow: 0 9px 25px rgba(80, 55, 30, 0.06);
}

.quick-icon,
.large-feature-icon {
  display: grid;
  place-items: center;
  border-radius: 13px;
  font-size: 23px;
  font-weight: 700;
}

.quick-icon {
  width: 43px;
  height: 43px;
  margin-bottom: 5px;
}

.orange-icon {
  color: #df8337;
  background: #fff0e3;
}

.green-icon {
  color: #4b9870;
  background: #eaf6ee;
}

.purple-icon {
  color: #8c75b6;
  background: #f1edfa;
}

.yellow-icon {
  color: #c79536;
  background: #fff6df;
}

.quick-card strong {
  font-size: 14px;
}

.quick-card small {
  color: #948a80;
  font-size: 11px;
}

.quick-arrow {
  position: absolute;
  right: 19px;
  top: 20px;
  color: #d2a17b;
  font-size: 20px;
}

.inspiration-section {
  margin-top: 5px;
}

.inspiration-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
}

.food-card {
  overflow: hidden;
  background: white;
  border: 1px solid #eee9e2;
  border-radius: 17px;
}

.food-card img {
  width: 100%;
  height: 175px;
  object-fit: cover;
  display: block;
}

.food-card div {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.food-card strong {
  font-size: 14px;
}

.food-card span {
  color: #92887e;
  font-size: 11px;
}

.bottom-navigation {
  position: fixed;
  z-index: 20;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: 76px;
  padding: 8px max(12px, calc((100vw - 800px) / 2));
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1px solid #eee9e2;
  backdrop-filter: blur(18px);
}

.nav-item {
  min-width: 65px;
  border: none;
  background: transparent;
  color: #948a80;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 5px 8px;
  border-radius: 12px;
  transition: 0.2s;
}

.nav-icon {
  font-size: 23px;
  line-height: 1.1;
}

.nav-label {
  font-size: 10px;
  font-weight: 600;
}

.nav-item.active {
  color: #e98b3c;
  background: #fff5ec;
}

.page-content {
  max-width: 850px;
  margin: 0 auto;
  min-height: 65vh;
}

.page-content h1 {
  margin-bottom: 8px;
}

.page-description {
  margin-bottom: 27px;
}

.feature-panel,
.info-panel,
.profile-panel,
.settings-list {
  background: white;
  border: 1px solid #eee9e2;
  border-radius: 18px;
  padding: 25px;
  margin-bottom: 18px;
}

.feature-panel h2 {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  margin: 0 0 10px;
}

.feature-panel > p,
.info-panel p {
  color: #898076;
  font-size: 13px;
  line-height: 1.7;
}

.large-feature-icon {
  width: 55px;
  height: 55px;
  margin-bottom: 20px;
}

.search-input,
.add-item-form input {
  width: 100%;
  min-width: 0;
  border: 1px solid #e9dfd3;
  background: #fffdfa;
  border-radius: 11px;
  padding: 14px;
  outline: none;
  font-size: 13px;
}

.search-input:focus,
.add-item-form input:focus {
  border-color: #e98b3c;
  box-shadow: 0 0 0 3px #ffe8d4;
}

.feature-panel > .primary-button {
  margin-top: 13px;
}

.info-panel strong {
  font-size: 14px;
}

.planning-banner {
  overflow: hidden;
  border-radius: 18px;
  background: #fff0e3;
  margin-bottom: 22px;
}

.planning-banner img {
  width: 100%;
  height: 190px;
  object-fit: cover;
  display: block;
}

.planning-banner div {
  padding: 23px;
}

.planning-banner h2 {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  margin: 9px 0;
}

.planning-banner p {
  color: #83766a;
  font-size: 13px;
  margin: 0;
  line-height: 1.6;
}

.planning-step {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px 0;
  border-bottom: 1px solid #f1ede8;
}

.planning-step > span:first-child {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #fff0e3;
  color: #df8337;
  font-size: 12px;
  font-weight: 800;
}

.planning-step strong {
  font-size: 13px;
  flex: 1;
}

.step-arrow {
  color: #b8aa9b;
  font-size: 20px;
}

.full-button {
  width: 100%;
  margin-top: 20px;
}

.add-item-form {
  display: flex;
  gap: 10px;
  margin: 20px 0;
}

.add-item-form .primary-button {
  white-space: nowrap;
}

.empty-list {
  padding: 30px 10px;
  text-align: center;
  color: #948a80;
}

.empty-list > span {
  display: block;
  font-size: 30px;
  margin-bottom: 12px;
  color: #e6a36e;
}

.empty-list strong {
  color: #51483e;
  font-size: 14px;
}

.empty-list p {
  font-size: 12px;
}

.shopping-feedback {
  margin: 0 0 16px;
  padding: 13px 15px;
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.5;
}

.shopping-feedback.error {
  border: 1px solid #f1c8c0;
  background: #fff2ef;
  color: #a63f34;
}

.shopping-feedback.success {
  border: 1px solid #cfe7d3;
  background: #f0faf1;
  color: #347347;
}

.shopping-items {
  display: flex;
  flex-direction: column;
}

.shopping-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 3px;
  border-bottom: 1px solid #f1ede8;
  font-size: 13px;
}

.shopping-item > span {
  flex: 1;
  line-height: 1.5;
}

.shopping-item > button {
  flex: 0 0 auto;
  border: none;
  background: #fff0ee;
  color: #c65345;
  border-radius: 9px;
  padding: 7px 11px;
  font-size: 16px;
}

.shopping-item > button:disabled {
  cursor: wait;
  opacity: 0.6;
}

.shopping-item input {
  accent-color: #e98b3c;
  width: 17px;
  height: 17px;
}

.item-done {
  color: #a69c91;
  text-decoration: line-through;
}

.saved-recipes-panel {
  overflow: hidden;
  margin-bottom: 20px;
  border: 1px solid #f0dfd4;
  border-radius: 20px;
  background: linear-gradient(135deg, #fff8f1 0%, #fff 70%);
  box-shadow: 0 8px 26px rgba(89, 54, 29, 0.045);
}

.saved-recipes-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  padding: 22px 24px;
}

.saved-recipes-heading h2 {
  margin: 6px 0 4px;
  color: #3a3028;
  font-family: 'Playfair Display', serif;
  font-size: 23px;
}

.saved-recipes-heading p {
  margin: 0;
  color: #898076;
  font-size: 13px;
}

.saved-recipes-toggle {
  flex: 0 0 auto;
  border: 0;
  border-radius: 12px;
  padding: 13px 17px;
  background: #e98b3c;
  color: #fff;
  font-weight: 750;
  transition: background 0.2s ease, transform 0.2s ease;
}

.saved-recipes-toggle:hover {
  transform: translateY(-1px);
  background: #d8792d;
}

.saved-recipes-content {
  padding: 0 20px 20px;
}

.saved-recipes-empty {
  border: 1px dashed #ecd7c6;
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.75);
}

.saved-recipe-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 18px;
}

.saved-recipe-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #eee4dc;
  border-radius: 17px;
  background: #fff;
  box-shadow: 0 5px 20px rgba(80, 52, 33, 0.055);
}

.saved-recipe-image-wrap {
  height: 190px;
  position: relative;
  overflow: hidden;
  background: #f7eee9;
}

.saved-recipe-image-wrap img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.saved-recipe-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  border-radius: 30px;
  padding: 7px 11px;
  background: rgba(255, 255, 255, 0.95);
  color: #a64c40;
  font-size: 12px;
  font-weight: 750;
}

.saved-recipe-body {
  padding: 17px;
}

.saved-recipe-card-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.saved-recipe-subtitle {
  color: #a1795b;
  font-size: 11px;
  font-weight: 700;
}

.saved-recipe-card-heading h3 {
  margin: 7px 0 0;
  color: #382f29;
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  line-height: 1.3;
}

.saved-recipe-delete {
  flex: 0 0 auto;
  width: 37px;
  height: 37px;
  border: 0;
  border-radius: 10px;
  background: #fff0ee;
  color: #c65345;
  font-size: 16px;
}

.saved-recipe-delete:disabled {
  cursor: wait;
  opacity: 0.6;
}

.saved-recipe-description {
  margin: 10px 0 17px;
  color: #80716c;
  font-size: 13px;
  line-height: 1.55;
}

.saved-recipe-ingredients-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 7px;
  color: #493a31;
  font-size: 12px;
}

.saved-recipe-ingredients-heading span {
  color: #98877a;
  white-space: nowrap;
}

.saved-recipe-ingredients {
  border: 1px solid #f0e9e3;
  border-radius: 12px;
  overflow: hidden;
}

.saved-recipe-ingredient {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 43px;
  padding: 9px 11px;
  border-bottom: 1px solid #f2ede9;
  color: #554941;
  font-size: 12px;
  cursor: pointer;
}

.saved-recipe-ingredient:last-child {
  border-bottom: 0;
}

.saved-recipe-ingredient input {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  accent-color: #e98b3c;
}

.saved-recipe-ingredient > span {
  flex: 1;
}

.saved-recipe-ingredient strong {
  color: #a64c40;
  white-space: nowrap;
}

.saved-recipe-instructions-toggle {
  width: 100%;
  margin-top: 14px;
  border: 1px solid #f0dfd4;
  border-radius: 11px;
  padding: 12px;
  background: #fff8f1;
  color: #a64c40;
  font-size: 12px;
  font-weight: 750;
  text-align: left;
}

.saved-recipe-instructions {
  display: flex;
  flex-direction: column;
  gap: 11px;
  margin: 13px 0 0;
  padding: 0;
  list-style: none;
}

.saved-recipe-instructions li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.saved-recipe-instructions li > span {
  flex: 0 0 25px;
  height: 25px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #fff0ec;
  color: #b94c40;
  font-size: 11px;
  font-weight: 800;
}

.saved-recipe-instructions p {
  margin: 3px 0 0;
  color: #655650;
  font-size: 12px;
  line-height: 1.55;
}

.profile-panel {
  display: flex;
  align-items: center;
  gap: 17px;
}

.large-avatar {
  width: 58px;
  height: 58px;
  flex-shrink: 0;
}

.profile-panel > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}

.profile-panel strong {
  font-size: 16px;
}

.profile-panel span {
  color: #948a80;
  font-size: 12px;
  overflow-wrap: anywhere;
}

.settings-list {
  padding: 5px 22px;
}

.settings-row {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 17px 0;
  border-bottom: 1px solid #f1ede8;
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-icon {
  width: 39px;
  height: 39px;
  border-radius: 12px;
  background: #fff3e8;
  color: #df8337;
  display: grid;
  place-items: center;
  font-size: 19px;
}

.settings-row div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.settings-row strong {
  font-size: 13px;
}

.settings-row small {
  color: #948a80;
  font-size: 11px;
}

.logout-button {
  width: 100%;
  border: 1px solid #f1d5ce;
  border-radius: 12px;
  background: #fff5f2;
  color: #bd5a48;
  padding: 15px;
  font-size: 13px;
  font-weight: 700;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: 0.2s;
}

.logout-button:hover {
  background: #ffebe5;
}

.loading-screen,
.login-required {
  min-height: 100vh;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 12px;
  padding: 20px;
  text-align: center;
  background: #faf9f7;
}

.loading-logo {
  font-size: 45px;
}

.loading-screen p {
  color: #948a80;
  font-size: 13px;
}

.login-required-card {
  width: min(420px, 100%);
  background: white;
  border: 1px solid #eee9e2;
  border-radius: 20px;
  padding: 35px;
}

.login-required-card h1 {
  font-family: 'Playfair Display', serif;
}

.login-required-card p {
  color: #898076;
  font-size: 13px;
  line-height: 1.7;
}

@media (max-width: 650px) {
  .topbar {
    height: 66px;
    padding: 0 5%;
  }

  .brand-button {
    font-size: 16px;
  }

  .brand-mark {
    width: 37px;
    height: 37px;
  }

  .topbar-greeting {
    display: none;
  }

  .main-content {
    width: 90%;
    padding-top: 30px;
  }

  .hero-card {
    grid-template-columns: 1fr;
  }

  .hero-copy {
    padding: 27px;
  }

  .hero-image {
    min-height: 180px;
    max-height: 210px;
  }

  .quick-grid {
    gap: 10px;
  }

  .quick-card {
    padding: 15px;
    min-height: 145px;
  }

  .quick-card strong {
    font-size: 12px;
  }

  .quick-card small {
    font-size: 10px;
    line-height: 1.5;
  }

  .inspiration-grid {
    gap: 10px;
  }

  .food-card img {
    height: 125px;
  }

  .food-card div {
    padding: 12px;
  }

  .food-card strong {
    font-size: 12px;
  }

  .food-card span {
    font-size: 10px;
  }

  .bottom-navigation {
    min-height: 72px;
    padding: 7px 3px;
  }

  .nav-item {
    min-width: 0;
    flex: 1;
    padding: 7px 2px;
  }

  .nav-icon {
    font-size: 21px;
  }

  .nav-label {
    font-size: 9px;
  }

  .feature-panel,
  .info-panel {
    padding: 19px;
  }

  .add-item-form {
    flex-direction: column;
  }

  .add-item-form .primary-button {
    width: 100%;
  }

  .saved-recipes-heading {
    align-items: flex-start;
    flex-direction: column;
    padding: 19px;
  }

  .saved-recipes-toggle {
    width: 100%;
  }

  .saved-recipes-content {
    padding: 0 13px 14px;
  }

  .saved-recipe-grid {
    grid-template-columns: 1fr;
  }

  .saved-recipe-image-wrap {
    height: 205px;
  }
}


/* ==================================
   ESSENPLAN - PREMIUM PLANUNG
================================== */

.plan-page {
  max-width: 920px;
  animation: planFadeIn .4s ease;
}

@keyframes planFadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

.plan-heading h1 {
  margin-bottom: 8px;
}

.plan-welcome-banner {
  position: relative;
  height: 270px;
  border-radius: 23px;
  overflow: hidden;
  margin: 25px 0;
  background: #493d30;
}

.plan-welcome-banner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.plan-welcome-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28px;
  color: white;
  background: linear-gradient(
    0deg,
    rgba(25, 20, 15, .85),
    rgba(25, 20, 15, .05)
  );
}

.plan-welcome-overlay > span {
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 800;
  color: #ffd3ad;
}

.plan-welcome-overlay h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(24px, 4vw, 34px);
  margin: 10px 0;
}

.plan-welcome-overlay p {
  margin: 0;
  font-size: 13px;
  color: #f5e9df;
  line-height: 1.6;
}

.plan-progress-card {
  background: white;
  padding: 21px;
  border: 1px solid #eee9e2;
  border-radius: 17px;
  margin: 22px 0;
}

.plan-progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.plan-progress-top > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.plan-progress-top span {
  color: #e98b3c;
  font-size: 9px;
  letter-spacing: 1.5px;
  font-weight: 800;
}

.plan-progress-top strong {
  font-size: 14px;
}

.plan-progress-percent {
  font-size: 21px;
  font-weight: 800;
  color: #e98b3c;
}

.plan-progress-track {
  height: 8px;
  background: #f1eee9;
  border-radius: 20px;
  overflow: hidden;
}

.plan-progress-track span {
  display: block;
  height: 100%;
  border-radius: 20px;
  background: linear-gradient(90deg, #e98b3c, #f5b36d);
  transition: width .4s ease;
}

.plan-progress-dots {
  display: flex;
  gap: 6px;
  margin-top: 13px;
}

.plan-progress-dots span {
  flex: 1;
  height: 4px;
  border-radius: 10px;
  background: #eee9e2;
}

.plan-progress-dots span.completed {
  background: #e98b3c;
}

.plan-step-card {
  background: white;
  border: 1px solid #eee9e2;
  border-radius: 21px;
  padding: clamp(19px, 4vw, 32px);
  box-shadow: 0 8px 30px rgba(70, 50, 30, .035);
  animation: planFadeIn .35s ease;
}

.plan-step-heading {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding-bottom: 24px;
  border-bottom: 1px solid #f0ece7;
  margin-bottom: 27px;
}

.plan-step-number {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 15px;
  background: #fff0e3;
  color: #df8337;
  font-size: 16px;
  font-weight: 800;
}

.plan-step-heading h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(21px, 3vw, 27px);
  margin: 0 0 7px;
}

.plan-step-heading p {
  color: #8b8177;
  font-size: 13px;
  line-height: 1.6;
  margin: 0;
}

.plan-step-content {
  display: grid;
  gap: 22px;
}

.plan-section-title h3 {
  font-size: 15px;
  margin: 0 0 6px;
}

.plan-section-title p {
  color: #968b80;
  font-size: 12px;
  line-height: 1.6;
  margin: 0;
}

.plan-supermarket-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.plan-supermarket {
  position: relative;
  min-height: 130px;
  padding: 15px 8px;
  border: 1px solid #eee9e2;
  border-radius: 16px;
  background: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: .2s;
}

.plan-supermarket:hover,
.plan-supermarket.selected {
  border: 2px solid #ed8b43;
  background: #fff9f3;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(220, 130, 55, .09);
}

.plan-shop-logo {
  height: 48px;
  width: 65px;
  display: grid;
  place-items: center;
}

.plan-shop-logo img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.plan-shop-fallback {
  display: none;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 2px solid currentColor;
  border-radius: 12px;
  font-weight: 900;
  font-size: 17px;
}

.plan-supermarket > strong {
  font-size: 13px;
}

.plan-shop-check {
  position: absolute;
  top: 8px;
  right: 9px;
  color: #e98b3c;
  font-weight: 900;
}

.plan-text-input {
  width: 100%;
  padding: 15px;
  border: 1px solid #e9dfd3;
  border-radius: 12px;
  background: #fffdfa;
  outline: none;
  font: inherit;
  font-size: 13px;
}

.plan-text-input:focus {
  border-color: #e98b3c;
  box-shadow: 0 0 0 3px #ffe8d4;
}

.plan-counter {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 17px;
  border: 1px solid #f0e8df;
  border-radius: 16px;
  background: #fffdfa;
}

.plan-counter-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.plan-counter-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: #fff0e3;
  font-size: 21px;
}

.plan-counter-info div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.plan-counter-info strong {
  font-size: 14px;
}

.plan-counter-info small {
  color: #968b80;
  font-size: 11px;
}

.plan-counter-controls {
  display: flex;
  align-items: center;
  gap: 13px;
}

.plan-counter-controls button {
  width: 35px;
  height: 35px;
  border: none;
  border-radius: 11px;
  background: #fff0e3;
  color: #d87527;
  font-size: 21px;
  font-weight: 700;
}

.plan-counter-controls button:last-child {
  background: #e98b3c;
  color: white;
}

.plan-counter-controls strong {
  min-width: 18px;
  text-align: center;
  font-size: 18px;
}

.plan-total-people {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 19px;
  background: #fff5eb;
  border-radius: 15px;
}

.plan-total-people > span {
  font-size: 29px;
}

.plan-total-people div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.plan-total-people small {
  color: #997b62;
  font-size: 11px;
}

.plan-total-people strong {
  color: #c66c28;
  font-size: 16px;
}

.plan-day-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 9px;
}

.plan-day {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
  padding: 13px;
  border: 1px solid #eee9e2;
  border-radius: 13px;
  background: white;
  text-align: left;
  transition: .2s;
}

.plan-day.selected {
  border: 2px solid #ed8b43;
  background: #fff6ee;
}

.plan-day small {
  color: #a79a8c;
  font-size: 9px;
  font-weight: 800;
}

.plan-day strong {
  font-size: 12px;
}

.plan-day span {
  color: #e98b3c;
  font-weight: 900;
}

.plan-selection-hint {
  margin: -12px 0 0;
  color: #a08e7e;
  font-size: 11px;
}

.plan-meal-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.plan-meal {
  position: relative;
  min-height: 140px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  padding: 15px;
  border: 1px solid #eee9e2;
  border-radius: 15px;
  background: white;
  text-align: left;
}

.plan-meal.selected {
  border: 2px solid #ed8b43;
  background: #fff7ef;
}

.plan-meal > span {
  font-size: 29px;
}

.plan-meal strong {
  font-size: 12px;
}

.plan-meal small {
  color: #948a80;
  font-size: 10px;
  line-height: 1.4;
}

.plan-meal i,
.plan-option i,
.plan-appliance i,
.plan-extra i {
  position: absolute;
  right: 10px;
  top: 10px;
  font-style: normal;
  color: #e98b3c;
  font-weight: 900;
}

.plan-budget {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  padding: 19px;
  border: 1px solid #f0e6dc;
  border-radius: 16px;
  background: #fff9f3;
}

.plan-budget > div:first-child {
  display: flex;
  align-items: center;
  gap: 12px;
}

.plan-budget > div:first-child > span {
  font-size: 28px;
}

.plan-budget > div:first-child div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.plan-budget strong {
  font-size: 14px;
}

.plan-budget small {
  font-size: 11px;
  color: #97897c;
}

.plan-budget-value {
  display: flex;
  align-items: center;
  gap: 7px;
}

.plan-budget-value input {
  width: 100px;
  padding: 10px;
  border: 1px solid #ead9c9;
  border-radius: 10px;
  background: white;
  font-size: 17px;
  font-weight: 800;
  color: #d8792d;
}

.plan-budget-value > strong {
  font-size: 20px;
  color: #d8792d;
}

.plan-profile-box {
  display: flex;
  gap: 13px;
  align-items: center;
  background: #fff5eb;
  border-radius: 15px;
  padding: 17px;
}

.plan-profile-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  background: white;
  border-radius: 13px;
  font-size: 21px;
}

.plan-profile-box strong {
  font-size: 13px;
}

.plan-profile-box p {
  margin: 5px 0 0;
  color: #928477;
  font-size: 11px;
  line-height: 1.5;
}

.plan-food-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.plan-food-tags span {
  padding: 9px 12px;
  border-radius: 20px;
  background: #fff1e5;
  color: #c96d24;
  font-size: 12px;
  font-weight: 650;
}

.plan-food-tags.dislikes span {
  background: #fff0ee;
  color: #b94c40;
}

.plan-food-tags p {
  color: #968b80;
  font-size: 12px;
}

.plan-empty-friends {
  padding: 25px;
  border: 1px dashed #eaded1;
  border-radius: 15px;
  text-align: center;
  background: #fffdfa;
}

.plan-empty-friends span {
  font-size: 30px;
}

.plan-empty-friends strong {
  display: block;
  margin-top: 9px;
  font-size: 13px;
}

.plan-empty-friends p {
  color: #968b80;
  font-size: 11px;
  line-height: 1.6;
}

.plan-friend-grid {
  display: grid;
  gap: 9px;
}

.plan-friend {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px;
  background: white;
  border: 1px solid #eee9e2;
  border-radius: 13px;
  text-align: left;
}

.plan-friend.selected {
  border: 2px solid #ed8b43;
  background: #fff7ef;
}

.plan-friend-avatar {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #ffe8d4;
  color: #d8792d;
  font-weight: 800;
}

.plan-friend strong {
  flex: 1;
  font-size: 13px;
}

.plan-friend > span:last-child {
  color: #e98b3c;
  font-weight: 900;
}

.plan-option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.plan-option {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 65px;
  padding: 13px;
  border: 1px solid #eee9e2;
  border-radius: 14px;
  background: white;
  text-align: left;
}

.plan-option.selected {
  border: 2px solid #ed8b43;
  background: #fff7ef;
}

.plan-option > span {
  font-size: 22px;
}

.plan-option strong {
  font-size: 12px;
  padding-right: 13px;
}

.plan-allergy-notice {
  padding: 14px;
  border-radius: 12px;
  background: #fff7e8;
  color: #92703c;
  font-size: 11px;
  line-height: 1.6;
}

.plan-appliance-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.plan-appliance {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
  min-height: 130px;
  padding: 15px;
  border: 1px solid #eee9e2;
  border-radius: 15px;
  background: white;
  text-align: left;
}

.plan-appliance.selected {
  border: 2px solid #ed8b43;
  background: #fff7ef;
}

.plan-appliance > span {
  font-size: 27px;
}

.plan-appliance strong {
  font-size: 12px;
}

.plan-appliance small {
  font-size: 10px;
  color: #948a80;
}

.plan-extra-grid {
  display: grid;
  gap: 9px;
}

.plan-extra {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  border: 1px solid #eee9e2;
  border-radius: 13px;
  background: white;
  text-align: left;
}

.plan-extra.selected {
  border: 2px solid #ed8b43;
  background: #fff7ef;
}

.plan-extra > span {
  font-size: 21px;
}

.plan-extra strong {
  font-size: 12px;
}

.plan-navigation {
  display: flex;
  gap: 11px;
  margin-top: 28px;
  padding-top: 21px;
  border-top: 1px solid #f0ece7;
}

.plan-back-button,
.plan-next-button {
  min-height: 49px;
  padding: 12px 16px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 750;
  transition: .2s;
}

.plan-back-button {
  flex: 1;
  border: 1px solid #eee9e2;
  background: white;
  color: #6f655b;
}

.plan-next-button {
  flex: 2;
  border: none;
  background: #e98b3c;
  color: white;
}

.plan-next-button:hover:not(:disabled) {
  background: #d8792d;
  transform: translateY(-2px);
}

.plan-next-button:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.plan-footer-note {
  text-align: center;
  color: #a39689;
  font-size: 11px;
  margin-top: 18px;
}

/* Ladebildschirm */

.plan-loading {
  min-height: 65vh;
  display: grid;
  place-items: center;
  text-align: center;
  padding: 30px 15px;
  animation: planFadeIn .35s ease;
}

.plan-loading-content {
  max-width: 420px;
}

.plan-loading-orbit {
  width: 125px;
  height: 125px;
  margin: 0 auto 25px;
  display: grid;
  place-items: center;
  border: 2px dashed #f2c49d;
  border-radius: 50%;
  animation: planSpin 9s linear infinite;
}

.plan-loading-circle {
  width: 85px;
  height: 85px;
  display: grid;
  place-items: center;
  background: #fff0e3;
  border-radius: 27px;
  font-size: 43px;
  animation: planCounterSpin 9s linear infinite;
}

@keyframes planSpin {
  to { transform: rotate(360deg); }
}

@keyframes planCounterSpin {
  to { transform: rotate(-360deg); }
}

.plan-loading h1 {
  font-family: 'Playfair Display', serif;
  font-size: 29px;
  margin: 12px 0;
}

.plan-loading p {
  color: #918579;
  font-size: 13px;
  line-height: 1.6;
}

.plan-loading-bar {
  width: min(280px, 80vw);
  height: 6px;
  background: #f0e9e1;
  border-radius: 20px;
  overflow: hidden;
  margin: 25px auto;
}

.plan-loading-bar span {
  display: block;
  width: 35%;
  height: 100%;
  background: #e98b3c;
  border-radius: 20px;
  animation: planLoadingBar 1.5s ease-in-out infinite;
}

@keyframes planLoadingBar {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(300%); }
}

.plan-loading-tips {
  display: flex;
  justify-content: center;
  gap: 17px;
  font-size: 22px;
  margin-top: 30px;
}

/* Zusammenfassung */

.plan-success-hero {
  padding: 30px 20px;
  margin-bottom: 20px;
  text-align: center;
  border-radius: 20px;
  background: #fff1e5;
}

.plan-success-icon {
  width: 65px;
  height: 65px;
  display: grid;
  place-items: center;
  margin: 0 auto 17px;
  border-radius: 50%;
  background: #e98b3c;
  color: white;
  font-size: 30px;
  font-weight: 800;
}

.plan-success-hero h1 {
  font-family: 'Playfair Display', serif;
  font-size: 32px;
  margin: 10px 0;
}

.plan-success-hero p {
  color: #8f7d6d;
  font-size: 13px;
}

.plan-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.plan-summary-card {
  padding: 19px;
  background: white;
  border: 1px solid #eee9e2;
  border-radius: 16px;
}

.plan-summary-card > span {
  display: block;
  font-size: 25px;
  margin-bottom: 12px;
}

.plan-summary-card small {
  display: block;
  color: #978b7f;
  font-size: 11px;
  margin-bottom: 5px;
}

.plan-summary-card strong {
  display: block;
  font-size: 16px;
}

.plan-summary-card p {
  color: #968b80;
  font-size: 11px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.plan-summary-details {
  display: grid;
  gap: 17px;
}

.plan-summary-details h2 {
  font-family: 'Playfair Display', serif;
  margin: 0;
}

.plan-summary-details > div {
  padding-bottom: 13px;
  border-bottom: 1px solid #f1ede8;
}

.plan-summary-details > div strong {
  font-size: 13px;
}

.plan-summary-details > div p {
  margin: 6px 0 0;
  color: #8c8177;
  font-size: 12px;
  line-height: 1.6;
}

.plan-next-info {
  display: flex;
  gap: 13px;
  align-items: center;
  padding: 18px;
  border-radius: 16px;
  background: #fff5eb;
  margin-top: 18px;
}

.plan-next-info > span {
  font-size: 29px;
}

.plan-next-info strong {
  font-size: 13px;
}

.plan-next-info p {
  color: #8c7c6d;
  font-size: 11px;
  line-height: 1.6;
  margin: 5px 0 0;
}

@media (max-width: 650px) {
  .plan-welcome-banner {
    height: 225px;
  }

  .plan-welcome-overlay {
    padding: 19px;
  }

  .plan-supermarket-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .plan-day-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .plan-meal-grid {
    grid-template-columns: 1fr;
  }

  .plan-meal {
    min-height: 100px;
  }

  .plan-appliance-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .plan-option-grid {
    grid-template-columns: 1fr;
  }

  .plan-counter {
    align-items: flex-start;
    flex-direction: column;
  }

  .plan-counter-controls {
    align-self: flex-end;
  }

  .plan-budget {
    align-items: flex-start;
    flex-direction: column;
  }

  .plan-navigation {
    flex-direction: column-reverse;
  }

  .plan-back-button,
  .plan-next-button {
    flex: auto;
    width: 100%;
  }

  .plan-summary-grid {
    grid-template-columns: 1fr;
  }
}
